# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Apps Script Web App URL for lead, chat-start & meeting alerts (free, no Blaze needed)
VITE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional: Your Cal.com scheduling link (e.g. https://cal.com/hisabsutra/15min)
VITE_CALCOM_URL=""

# Optional: Firebase App Check (reCAPTCHA v3 site key)
VITE_RECAPTCHA_SITE_KEY="MY_RECAPTCHA_V3_SITE_KEY"

# Optional: Override Firebase config when moving to your own free Spark-plan Firebase project
# Set VITE_FIREBASE_DATABASE_ID="(default)" when using the default Firestore database
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID="(default)"
